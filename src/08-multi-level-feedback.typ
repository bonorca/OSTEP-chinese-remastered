// MLFQ 时间线图（图 8.2–8.6）：三行队列 Q2、Q1、Q0，每行高 36.7pt；
// 色块数据 (x, y, 宽, 高, 颜色) 从原 PDF 的矢量矩形里读出、按原尺寸重画（x 从轴起点前 1pt 算起），0 为黑、212 为灰
#let mlfq(runs, w: 110.8pt, tmax: 200, step: 50) = {
  let L = 20pt
  let rowh = 36.7pt
  box(width: L + w + 8pt, height: 3 * rowh + 18pt, {
    set text(font: sans, size: 7pt)
    for (x, y, ww, hh, c) in runs {
      place(top + left, dx: L + (x - 1) * 1pt, dy: y * 1pt,
        rect(width: calc.max(ww, 0.3) * 1pt, height: hh * 1pt, fill: if c == 0 { black } else { luma(212) }, stroke: none))
    }
    for (i, q) in ("Q2", "Q1", "Q0").enumerate() {
      place(top + left, dx: 0pt, dy: i * rowh + rowh / 2 - 5pt, box(width: L - 4pt, height: 10pt, align(right + horizon, q)))
      if i < 2 {
        place(top + left, line(start: (L, (i + 1) * rowh), end: (L + w, (i + 1) * rowh),
          stroke: (thickness: 0.6pt, dash: "dotted")))
      }
    }
    let ya = 3 * rowh
    place(top + left, line(start: (L, ya), end: (L + w, ya), stroke: 0.6pt))
    for t in range(0, tmax + 1, step: step) {
      let x = L + w * t / tmax
      place(top + left, line(start: (x, ya), end: (x, ya + 3pt), stroke: 0.6pt))
      place(top + left, dx: x - 12pt, dy: ya + 4pt, box(width: 24pt, align(center, str(t))))
    }
  })
}

// 图 8.1 里的作业圆圈和箭头
#let job(x, y, name) = place(top + left, dx: x - 8pt, dy: y - 8pt, circle(radius: 8pt, stroke: 0.6pt, align(center + horizon, name)))
#let harrow(x1, x2, y) = {
  place(top + left, line(start: (x1, y), end: (x2 - 4pt, y), stroke: 0.6pt))
  place(top + left, polygon(fill: black, (x2 - 5pt, y - 2pt), (x2 - 5pt, y + 2pt), (x2, y)))
}

