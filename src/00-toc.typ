#import "ostep.typ": *

// 目录不是正式章节：没有章号，页码用罗马数字。
// 前言占 iii–xi，目录从下一个奇数页 xiii 开始（原书前言到 xiv，目录从 xv 开始）。
// 首页照章首的样子排（折角线加右对齐的标题，没有章号），页码在页底居中；
// 其余各页页眉左边是「目录」、右边是页码。页脚照原书目录：VERSION 1.10、2008–23。
//
// 不印页码：原书目录的页码是英文合订本的页码，中文版每章单独成册、各自从第 1 页编起，
// 印出来对不上，所以去掉页码和引导点，只保留章节结构。
// 原书目录末尾的总索引、补充索引、提示索引、关键问题索引，中文版没有对应内容，不列。
// 条目数据在文件末尾，由脚本按原书目录逐条匹配各章 .typ 里已定的标题生成。

#let first-page = 13
#let roman() = numbering("i", if book-mode { counter(page).get().first() } else { here().page() + first-page - 1 })

#set document(title: "目录") if not book-mode
#set page(
  width: 432pt, height: 648pt,
  margin: (x: margin-x, top: body-top, bottom: 648pt - body-bottom),
  background: context {
    set text(font: serif, size: body-size, top-edge: "baseline", bottom-edge: "baseline")
    let at(y, body) = place(top + left, dx: margin-x, dy: y, box(width: text-width, body))
    if local-page() == 1 {
      at(foot-y, align(center, roman()))
    } else {
      at(head-y, [目录 #h(1fr) #roman()])
      place(top + left, dx: margin-x, dy: head-y + 3.5pt, line(length: text-width, stroke: 0.4pt))
      at(foot-y, text(size: 8pt)[
        #fsc("Operating Systems [Version 1.10]") #h(1fr) #fsc("© 2008–23, Arpaci-Dusseau")])
    }
  },
)

#set text(font: serif, size: body-size, lang: "zh", region: "cn", top-edge: 0.88em, bottom-edge: -0.12em)
#show raw: set text(font: mono, size: 1.25em)
#show "I/O": box

// 首页：折角线加右对齐的标题
#block(height: 200pt - body-top - 0.88 * body-size, width: 100%, below: 0pt, {
  set text(top-edge: "baseline", bottom-edge: "baseline")
  place(top + left, dy: 126pt - body-top, line(length: text-width, stroke: 0.5pt))
  place(top + left, dx: text-width, dy: 84pt - body-top, line(angle: 90deg, length: 42pt, stroke: 0.5pt))
  place(top + left, dy: 154pt - body-top, box(width: text-width, align(right, text(font: sans, size: 14.3pt)[目录])))
})

// 三列：章号、节号、标题；和原书一样，章号顶格，节号和「参考文献」「作业」缩进一级
#let ind = 20pt
#let secw = 30pt
#let gap = 2.6pt
#let entry(it) = {
  let t = eval(it.title, mode: "markup")
  if it.kind == "part" {
    block(above: 16pt, below: 8pt, sticky: true,
      text(size: 11pt, weight: "bold")[#it.no#h(1em)#it.title])
  } else if it.kind == "ch" {
    block(above: 9pt, below: gap, sticky: true,
      grid(columns: (ind, 1fr), strong(it.no), strong(t)))
  } else if it.kind == "sec" {
    block(above: gap, below: gap,
      grid(columns: (ind, secw, 1fr), [], it.no, t))
  } else {
    block(above: gap, below: gap, grid(columns: (ind, 1fr), [], t))
  }
}


